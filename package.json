{
  "name": "secret-gardens-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "packageManager": "bun@1.3.5",
  "scripts": {
    "build": "bunx turbo run build",
    "test": "bunx turbo run test --filter=!@secret-gardens/e2e",
    "test:e2e": "bun run --cwd e2e test",
    "typecheck": "bunx turbo run typecheck",
    "lint": "bunx turbo run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "bun-types": "1.3.5",
    "turbo": "^2.9.17",
    "typescript": "~5.9.3"
  }
}
